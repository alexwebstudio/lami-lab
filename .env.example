# Домен продакшена. Нужен для canonical, Open Graph, sitemap.xml и robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.kz

# Отправка заявок из формы записи в Telegram.
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather.
# TELEGRAM_CHAT_ID   — id чата или канала, куда бот шлёт заявки.
# Пока переменные пустые, форма честно сообщает, что отправка не подключена.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
